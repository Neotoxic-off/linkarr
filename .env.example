# The deployment's secrets, in .env next to docker-compose.yml (compose refuses to start without both keys).
# Generate them: printf 'MODULARR_API_KEY=%s\nVISULARR_API_KEY=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" >> .env
MODULARR_API_KEY=
VISULARR_API_KEY=

# Optional: how browsers reach each app (defaults: http://localhost:8080, :8096, :8070).
# MODULARR_PUBLIC_URL=http://localhost:8080
# VISULARR_PUBLIC_URL=http://localhost:8096
# LINKARR_PUBLIC_URL=http://localhost:8070

# Optional: the media folder and modularr's TMDB key.
# MEDIA_DIR=/path/to/media
# MODULARR_TMDB_API_KEY=

# Optional: a secret first-run setup asks for, so nobody else on the network can claim the admin account first.
# Recommended whenever linkarr is reachable beyond this host. Generate it: openssl rand -hex 16
# LINKARR_SETUP_TOKEN=

# Optional, behind a reverse proxy: the proxy's IP or network (';'-separated), whose X-Forwarded-For/Proto linkarr then trusts.
# Only the proxy: anything in that range can choose the client address linkarr sees.
# LINKARR_TRUSTED_PROXIES=172.18.0.0/16
